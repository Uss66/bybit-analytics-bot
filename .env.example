# Copy this file to .env (same folder) and fill in your real testnet API key/secret.
# Never commit .env or paste its contents into chat - it holds real credentials
# (even though these are testnet-only, no real funds are ever at risk).

BYBIT_TESTNET_API_KEY=your_key_here
BYBIT_TESTNET_API_SECRET=your_secret_here

# Optional - only set if you generated the key from Demo Trading (api-demo.bybit.com)
# instead of the default separate Testnet account. Leave unset/commented for the default.
# BYBIT_PAPER_MODE=demo

# Local TimescaleDB (docker-compose) - defaults already match docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bybit
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_DB=bybit_analytics

# Telegram entry/exit alerts (see project_telegram_alerts memory)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Real Bybit MAINNET account, READ-ONLY (wallet-balance scope only - never
# give this key trade/withdraw permissions). Used only to show a live
# balance line in Telegram alerts - see scripts/bybit_balance.py, which has
# no order-placement method anywhere in the file by design.
BYBIT_API_KEY=your_mainnet_readonly_key_here
BYBIT_API_SECRET=your_mainnet_readonly_secret_here

# Only needed to run scripts/seed_supabase.py (one-time/occasional local
# migration of live state into the Supabase instance GitHub Actions reads
# from) - the connection string from the Supabase project's Settings ->
# Database page. Never needed by the live pipeline itself, which reads the
# POSTGRES_* vars above (pointed at Supabase via GitHub Secrets in CI, at
# the local docker-compose instance here).
# SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
